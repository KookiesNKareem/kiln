// T2 metamorphic relations (06 §12.2). Transforms and predicates are implemented in crates/kiln-trust;
// `transform.op` and `expect.kind` name the Rust functions. `needs` says which engine part the assertion waits for.
{
  schema: "kiln.trust.metamorphic/1",
  designs: ["a100_sxm4_40gb", "v100_sxm2_32gb", "h100_sxm5_80gb", "h100_pcie_80gb", "tpu_v4", "tpu_v5e", "tpu_v6e"],
  arb_per_relation: 20,
  corners: ["central", "low", "high"],
  tiers: ["A", "B"],
  relations: [
    { id: "M1", name: "double off-chip bandwidth",
      transform: { op: "scale_offchip_bandwidth", k: 2.0 },
      workload: "llama3_8b:decode_b1",
      expect: { kind: "scaled_part", part: "t_offchip", k: 0.5 }, tolerance: 0.05,
      mechanism: "bandwidth enters time only through DRAM resource demands", needs: "kiln_sim::evaluate" },
    { id: "M2", name: "double peak compute on a memory-bound step",
      transform: { op: "scale_unit_count", kinds: ["matrix", "vector"], k: 2 },
      workload: "llama3_8b:decode_b1",
      expect: { kind: "ratio_in", lo: 0.97, hi: 1.0 },
      mechanism: "no hidden compute dependence on bandwidth-bound paths", needs: "kiln_sim::evaluate" },
    { id: "M3", name: "double peak compute on a compute-bound GEMM",
      transform: { op: "scale_unit_count", kinds: ["matrix"], k: 2 },
      workload: "gemm_8192",
      expect: { kind: "scaled_part", part: "t_compute", k: 0.5 }, tolerance: 0.05,
      mechanism: "compute demand and wave quantization", needs: "kiln_sim::evaluate" },
    { id: "M4", name: "halve one link's wire length",
      transform: { op: "halve_placement_offsets" },                   // die b: x 40 mm -> 20 mm
      designs: ["corpus/trust/designs/m4_two_die.json5"],
      expect: { kind: "wire_closed_form" }, tolerance: 0.01,
      mechanism: "placement -> wire -> link cost path (04 §7.1)", needs: "kiln-phys wire model (M3)" },
    { id: "M5", name: "add an idle unit",
      transform: { op: "add_idle_unit" },
      workload: "llama3_8b:decode_b8",
      expect: { kind: "idle_unit" },
      mechanism: "leakage and cap coupling; no free performance", needs: "kiln_sim::evaluate + kiln-phys area/power" },
    { id: "M6", name: "permute declaration order and rename ids",
      transform: { op: "permute_rename", prefix: "z" },
      workload: "llama3_8b:decode_b8",
      expect: { kind: "identical" },
      mechanism: "determinism, no name or order dependence (P4)", needs: "kiln_sim::evaluate" },
    { id: "M7", name: "split a memory, same totals",
      transform: { op: "split_memory", memory: { a100_sxm4_40gb: "slice", v100_sxm2_32gb: "slice", h100_sxm5_80gb: "slice", h100_pcie_80gb: "slice", tpu_v4: "vmem", tpu_v5e: "vmem", tpu_v6e: "vmem" } },
      workload: "llama3_8b:decode_b8",
      expect: { kind: "unchanged" }, tolerance: 1e-9,
      mechanism: "no free ports or bandwidth from partitioning (wire_model = ideal, fixed placement)", needs: "kiln_sim::evaluate" },
    { id: "M8", name: "fp8 weights on a weight-streaming decode step",
      transform: { op: "workload_weights_fp8" },
      workload: "llama3_8b:decode_b1",
      expect: { kind: "scaled_part", part: "t_weights", k: 0.5 }, tolerance: 0.05,
      mechanism: "precision bytes (I12) feed the memory floor", needs: "kiln_sim::evaluate" },
  ],
}
