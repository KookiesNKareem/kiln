{
 "schema": "kiln.phys.params/1",
 "note": "04 \u00a712.1 calibration registry: one physical role per parameter, prior, bounds, scope. Node-scoped priors live in tech/<node>.json (util_std_cell, p_ll, p_ls, v_th, alpha); this file holds family- and platform-scoped ones.",
 "params": {
  "u_place": {
   "role": "fraction of a die covered by its declared blocks (packing efficiency plus undeclared fill: channels, glue logic, interconnect stretched into floorplan slack)",
   "scope": "family",
   "unit": "1",
   "prior": {
    "v": 0.85,
    "q": "asm",
    "c": "L",
    "src": "kiln_assumed",
    "bounds": [
     0.5,
     0.95
    ],
    "fit": true,
    "note": "lower bound 0.5, not 0.7: published floorplans carry fill set by a few hard blocks and SerDes, not by area (Jouppi et al. ISCA 2021 Fig. 6: 'OCI blocks are stretched to fill space in the abutted floorplan because the die dimensions and overall layout are dominated by the TensorCore, CMEM, and SerDes locations')"
   },
   "group": "area"
  },
